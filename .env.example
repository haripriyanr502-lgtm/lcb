# =========================================================================
# LCB Brigade CMS Portal Configuration Template
# Copy this file to .env.local for local development
# Configure these in your Vercel Dashboard -> Project Settings -> Environment Variables
# =========================================================================

# Administrator Authentication
ADMIN_USERNAME=admin@lcbbrigade.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_at_least_32_chars

# Production Persistence: Vercel KV / Upstash Redis (Optional, recommended for multi-region serverless)
# KV_REST_API_URL=https://your-upstash-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token

# Production Persistence: GitHub Repository Auto-Sync (Optional, commits CMS edits back to GitHub)
# GITHUB_TOKEN=your_github_personal_access_token_with_repo_scope
# GITHUB_REPO=haripriyanr502-lgtm/lcb
